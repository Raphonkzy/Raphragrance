# Raphragrance Environment Configuration Template
# Copy this file to .env before deploying: cp .env.example .env

# Application settings
APP_ENV=production
DEBUG=false
PORT=8080

# Database Configuration:
# Option 1: SQLite (Recommended for Home Lab - zero setup, ultra lightweight)
# Leave DATABASE_URL empty or unset to automatically use local data/perfumes.db
# DATABASE_URL=

# Option 2: PostgreSQL
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=raphragrance
DATABASE_URL=postgresql://your_db_user:your_secure_password@postgres:5432/raphragrance

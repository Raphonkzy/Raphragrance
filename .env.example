# ==============================================================================
# Raphragrance Environment Configuration Reference
# ==============================================================================

# Node runtime environment ('development', 'production', or 'test')
NODE_ENV=production

# HTTP server port
PORT=3000

# Canonical public site URL (used in sitemaps, robots.txt, canonical metadata)
NEXT_PUBLIC_SITE_URL=https://raphragrance.com

# Database Configuration
# Path to SQLite database. Defaults to:
# - data/perfumes.public.db (when INCLUDE_COMMUNITY_EDGES is unset or false)
# - data/perfumes.full.db   (when INCLUDE_COMMUNITY_EDGES=true)
DATABASE_PATH=data/perfumes.public.db

# Data Safety & Dual-Database Guardrails (Gate 3)
# Set to 'true' to load community graph edges from data/perfumes.full.db.
# Default is 'false' (content-only + curated overrides).
INCLUDE_COMMUNITY_EDGES=false

# Fail-Closed Production Protection (Gate 3.1c)
# In production (NODE_ENV=production), setting INCLUDE_COMMUNITY_EDGES=true
# will throw a fatal error on startup unless ALLOW_FULL_DB_IN_PROD=true is explicitly set.
ALLOW_FULL_DB_IN_PROD=false

# Font License Compliance (Gate 8.2)
# If Gilroy font files are missing from assets/fonts/, setting ALLOW_FALLBACK_FONT=true
# allows the build to succeed with system font fallbacks. Default is false.
ALLOW_FALLBACK_FONT=false

# =============================================================================
# Git Ignore - Raphragrance
# =============================================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
*.env
**/.env
**/.env.*
backend/.env
frontend/.env*
*.pem
*.key
*.cert
*.crt

# Exception: Allow .env.example template to be tracked
!.env.example

# Database files & data dumps
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.csv
*.jsonl
pgdata/

# Python virtual environment & caches
.venv/
backend/.venv/
**/__pycache__/
*.py[cod]
*$py.class
*.log

# Node & Next.js build artifacts
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
